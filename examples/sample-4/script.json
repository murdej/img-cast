{
  "cssClasses": {
    "cursor": {
      "filter": "drop-shadow(2px 4px 3px rgba(0, 0, 0, 0.45))"
    },
    "marker": {
      "opacity": 0.85,
      "filter": "hue-rotate(140deg) saturate(2)"
    }
  },
  "macros": {
    "clickAt": {
      "name": "clickAt",
      "args": ["x", "y", { "name": "duration", "default": 500 }],
      "steps": [
        { "cmd": "slide", "id": "cursor", "x": "$(x)", "y": "$(y)", "duration": "$(duration)", "timingFunction": "ease-in-out" },
        { "cmd": "set", "id": "click", "moveTo": "cursor" },
        { "cmd": "animate", "id": "click", "animation": "click", "wait": true }
      ]
    },
    "showScreen": {
      "name": "showScreen",
      "args": ["url", { "name": "pause", "default": 400 }],
      "steps": [
        { "cmd": "set", "id": "app", "url": "$(url)" },
        { "cmd": "pause", "duration": "$(pause)" }
      ]
    }
  },
  "steps": [
    { "cmd": "image", "id": "app", "url": "../sample-1/ps-001.png" },
    { "cmd": "image", "id": "cursor", "url": "../sample-1/cursor.svg", "x": "10%", "y": "10%", "cssClass": "cursor" },
    { "cmd": "image", "id": "click", "url": "../sample-1/mark.svg", "x": "-100%", "y": "0",
      "xa": "center", "ya": "center", "cssClass": ["marker"], "styles": { "opacity": 0 } },

    { "cmd": "call", "name": "clickAt", "args": { "x": "910px", "y": "184px", "duration": 1200 } },
    { "cmd": "call", "name": "showScreen", "args": { "url": "../sample-1/ps-002.png" } },
    { "cmd": "call", "name": "clickAt", "args": { "x": "339px", "y": "586px" } },
    { "cmd": "call", "name": "showScreen", "args": { "url": "../sample-1/ps-003.png", "pause": 700 } },
    { "cmd": "call", "name": "clickAt", "args": { "x": "944px", "y": "114px" }, "async": true, "awid": "last" },
    { "cmd": "await", "awid": "last" },
    { "cmd": "call", "name": "showScreen", "args": { "url": "../sample-1/ps-001.png", "pause": 600 } }
  ],
  "animations": {
    "click": {
      "0%": { "transform": "scale(20)", "opacity": 0 },
      "50%": { "transform": "scale(20)", "opacity": 1 },
      "95%": { "transform": "scale(1)", "opacity": 1 },
      "100%": { "transform": "scale(1)", "opacity": 0 },
      "timingFunction": "linear",
      "duration": 500
    }
  }
}
